{
  "name": "forgeprint",
  "version": "0.2.5",
  "description": "Forgeprint catalog tooling. Every pipeline step runs here, not in CI configuration.",
  "keywords": [
    "forgeprint",
    "blueprints",
    "catalog",
    "cli",
    "agents",
    "ai-agents",
    "scaffolding"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/forgeprint/forgeprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgeprint/forgeprint.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/forgeprint/forgeprint/issues"
  },
  "type": "module",
  "bin": {
    "forgeprint": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsc --build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
