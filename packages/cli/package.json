{
  "name": "@forgeprint/cli",
  "version": "0.1.0",
  "description": "Forgeprint catalog tooling. Every pipeline step runs here, not in CI configuration.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "forgeprint": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
