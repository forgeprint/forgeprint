{
  "name": "forgeprint-mcp",
  "version": "0.2.5",
  "mcpName": "io.github.forgeprint/forgeprint",
  "description": "Forgeprint MCP server: resolve a profile to exactly one blueprint and return its setup recipe.",
  "keywords": [
    "forgeprint",
    "mcp",
    "model-context-protocol",
    "blueprints",
    "ai-agents",
    "claude-code",
    "scaffolding"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/forgeprint/forgeprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgeprint/forgeprint.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/forgeprint/forgeprint/issues"
  },
  "type": "module",
  "bin": {
    "forgeprint-mcp": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsc --build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "forgeprint": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
